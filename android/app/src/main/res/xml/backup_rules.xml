<?xml version="1.0" encoding="utf-8"?>
<!--
   Nothing leaves the device. Firepit holds conversations and who you talk to,
   and a cloud backup would put both somewhere neither you nor the people you
   are talking to agreed to.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
